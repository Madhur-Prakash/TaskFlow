# Must match INTERNAL_PROXY_SECRET in backend/.env exactly.
# This is read by the CRA dev server (setupProxy.js) at build/start time — it is
# NOT embedded in the browser bundle because the variable is only used in Node-side
# proxy code, not in any React component.
REACT_APP_INTERNAL_PROXY_SECRET = "YOUR_REACT_APP_INTERNAL_PROXY_SECRET"